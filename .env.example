# OpenAI API Key (Required for embeddings and Pydantic AI agent)
OPENAI_API_KEY=your_openai_api_key_here

# Pydantic Logfire Token (Optional: for cloud observability dashboard)
# LOGFIRE_TOKEN=your_logfire_token_here

# Langfuse Tracing (Alternative for Logfire)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# PostgreSQL DSN / Connection String (Optional: defaults to local PostgreSQL)
POSTGRES_SERVER_DSN=postgresql://postgres:postgres@localhost:5432
POSTGRES_DATABASE=agentic_rag
